
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

# --- Dataset ---
url = 'https://raw.githubusercontent.com/DataTalksClub/machine-learning-zoomcamp/main/cohorts/2026/data/car_fuel_efficiency_2026.csv'
df = pd.read_csv(url)

columns = ['engine_displacement', 'horsepower', 'vehicle_weight', 'model_year', 'fuel_efficiency_mpg']
df = df[columns]

# --- EDA: does fuel_efficiency_mpg have a long tail? ---
df.fuel_efficiency_mpg.hist(bins=50)
plt.show()
print(df.fuel_efficiency_mpg.describe())
print('skew:', df.fuel_efficiency_mpg.skew())
# Output: mean 29.998, median 30.0, min 19.8, max 41.2, skew 0.081
# -> roughly symmetric, no long tail

# --- Question 1: column with missing values ---
print(df.isnull().sum())
# Output: horsepower 877, all others 0
# -> Answer: horsepower

# --- Question 2: median of horsepower ---
print(df.horsepower.median())
# Output: 254.0
# -> Answer: 254

# --- Helpers and split ---
features = ['engine_displacement', 'horsepower', 'vehicle_weight', 'model_year']
target = 'fuel_efficiency_mpg'

def split(df, seed):
    n = len(df)
    n_val = int(n * 0.2)
    n_test = int(n * 0.2)
    n_train = n - n_val - n_test

    np.random.seed(seed)
    idx = np.arange(n)
    np.random.shuffle(idx)

    df_train = df.iloc[idx[:n_train]].reset_index(drop=True)
    df_val = df.iloc[idx[n_train:n_train + n_val]].reset_index(drop=True)
    df_test = df.iloc[idx[n_train + n_val:]].reset_index(drop=True)
    return df_train, df_val, df_test

def train_linear_regression(X, y, r=0.0):
    ones = np.ones(X.shape[0])
    X = np.column_stack([ones, X])
    XTX = X.T.dot(X) + r * np.eye(X.shape[1])
    w_full = np.linalg.inv(XTX).dot(X.T).dot(y)
    return w_full[0], w_full[1:]

def prepare_X(df, fill_value):
    return df[features].fillna(fill_value).values

def rmse(y, y_pred):
    return np.sqrt(((y - y_pred) ** 2).mean())

df_train, df_val, df_test = split(df, 42)
y_train, y_val = df_train[target].values, df_val[target].values
# Sizes: 6000 / 2000 / 2000

# --- Question 3: fill with 0 vs mean ---
hp_mean = df_train.horsepower.mean()  # mean from training data only

for name, fill in [('With 0', 0), ('With mean', hp_mean)]:
    w0, w = train_linear_regression(prepare_X(df_train, fill), y_train)
    y_pred = w0 + prepare_X(df_val, fill).dot(w)
    print(name, round(rmse(y_val, y_pred), 3))
# Output:
#   With 0     2.205
#   With mean  2.202
# -> Answer: With mean

# --- Question 4: regularization ---
for r in [0, 0.01, 0.1, 1, 5, 10, 100]:
    w0, w = train_linear_regression(prepare_X(df_train, 0), y_train, r=r)
    y_pred = w0 + prepare_X(df_val, 0).dot(w)
    print(r, round(rmse(y_val, y_pred), 4))
# Output:
#   0     2.2053
#   0.01  2.2058
#   0.1   2.2241
#   1     2.3492
#   5     2.4094
#   10    2.4195
#   100   2.4292
# -> Answer: 0

# --- Question 5: sensitivity to the seed ---
scores = []
for seed in range(10):
    df_tr, df_va, _ = split(df, seed)
    w0, w = train_linear_regression(prepare_X(df_tr, 0), df_tr[target].values)
    y_pred = w0 + prepare_X(df_va, 0).dot(w)
    scores.append(rmse(df_va[target].values, y_pred))

print('std:', round(np.std(scores), 3))
# Scores by seed 0-9:
#   2.2392, 2.2021, 2.1634, 2.2044, 2.2019, 2.2458, 2.2697, 2.1908, 2.2166, 2.2070
# Output: std: 0.029
# -> Answer: 0.029 (low, so the model is stable)

# --- Question 6: final model on the test set ---
df_tr, df_va, df_te = split(df, 9)
df_full_train = pd.concat([df_tr, df_va]).reset_index(drop=True)

w0, w = train_linear_regression(prepare_X(df_full_train, 0), df_full_train[target].values, r=0.001)
y_pred = w0 + prepare_X(df_te, 0).dot(w)
print(round(rmse(df_te[target].values, y_pred), 3))
# Output: 2.236
# -> Answer: 2.236
